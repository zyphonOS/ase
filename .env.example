# ASE Backend Environment
# Copy to .env and fill in values

# Agent wallet private key (Sepolia testnet only)
ASE_PRIVATE_KEY=

# RPC endpoint (default: public Sepolia node)
ASE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# The Graph subgraph URL (optional, for live indexed-data reads)
# Set to your Subgraph Studio query URL (needs an API key from studio.thegraph.com)
# e.g. https://api.studio.thegraph.com/query/<version>/<slug>
ASE_SUBGRAPH_URL=

# The Graph GraphQL query to run every cycle (optional, requires ASE_SUBGRAPH_URL)
# Example: "{ pools(first: 3) { id feeTier token0 { symbol } token1 { symbol } } }"
ASE_SUBGRAPH_QUERY=

# Chainlink price feed address (optional, live external market truth)
# Sepolia ETH/USD proxy: 0x694AA1769357215DE4FAC081bf1f309aDC325306
ASE_CHAINLINK_FEED=

# Data provider address for payments (x402-style)
ASE_PAYEE_ADDRESS=

# USDC contract on Sepolia (default: Circle native)
ASE_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Agent identity name
ASE_AGENT_NAME=ase.ethonline2026

# Arc Testnet (alternative chain)
# Set to these values to run ASE on Arc instead of Sepolia.
# Get free testnet USDC from https://faucet.circle.com (Arc Testnet, USDC)
# ASE_RPC_URL=https://rpc.testnet.arc.network
# ASE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# ASE_PAYEE_ADDRESS=0x... (any destination address on Arc testnet)
